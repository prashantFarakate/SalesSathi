# Copy this file to .env and fill in your keys.

# Groq API key — powers the RAG answer generation (via LangChain ChatGroq).
# Get one free at https://console.groq.com/keys
GROQ_API_KEY=

# Optional: override the default Groq model.
# llama-3.3-70b-versatile was retired in 2026; Groq recommends the gpt-oss models.
SALESSAATHI_MODEL=openai/gpt-oss-120b

# Optional: enables real Claude API lead scoring/drafting in the agent pipeline
# (falls back to a transparent heuristic if unset).
ANTHROPIC_API_KEY=
